{
  "name": "04 Daily Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule-daily-node",
      "name": "Schedule Trigger (09:00 AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [220, 240]
    },
    {
      "parameters": {},
      "id": "manual-trigger-node",
      "name": "Manual Trigger (Demo)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [220, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from private.n8n_daily_digest();",
        "options": {}
      },
      "id": "postgres-digest-node",
      "name": "Compute and Store Daily Digest",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [500, 330],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "supabase-pooler-cred",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.expo_push_token);\nif (!rows.length) return [];\nconst messages = rows.map(r => ({\n  to: r.expo_push_token,\n  title: r.title,\n  body: r.body,\n  data: r.data,\n  sound: 'default',\n  channelId: 'default'\n}));\nconst chunks = [];\nfor (let i = 0; i < messages.length; i += 100) {\n  chunks.push(messages.slice(i, i + 100));\n}\nreturn chunks.map(c => ({ json: { messages: c } }));"
      },
      "id": "code-batch-push-digest",
      "name": "Build Expo Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 330]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://exp.host/--/api/v2/push/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.messages) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "http-expo-push-digest",
      "name": "Send Expo Push Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 330]
    }
  ],
  "connections": {
    "Schedule Trigger (09:00 AM)": {
      "main": [
        [
          {
            "node": "Compute and Store Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger (Demo)": {
      "main": [
        [
          {
            "node": "Compute and Store Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute and Store Daily Digest": {
      "main": [
        [
          {
            "node": "Build Expo Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Expo Batch": {
      "main": [
        [
          {
            "node": "Send Expo Push Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}

