        "typeVersion": 2.5,
        "position": [
          1800,
          300
        ],
        "credentials": {
          "postgres": {
            "id": "supabase-pooler-cred",
            "name": "Supabase Postgres"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.expo_push_token);\nif (!rows.length) return [];\nconst messages = rows.map(r => ({\n  to: r.expo_push_token,\n  title: r.title,\n  body: r.body,\n  data: r.data,\n  sound: 'default',\n  channelId: 'default'\n}));\nconst chunks = [];\nfor (let i = 0; i < messages.length; i += 100) {\n  chunks.push(messages.slice(i, i + 100));\n}\nreturn chunks.map(c => ({ json: { messages: c } }));"
        },
        "id": "code-batch-push-highlights",
        "name": "Build Expo Batch",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
