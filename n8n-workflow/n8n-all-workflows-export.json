          }
        },
        "id": "http-expo-push-highlights",
        "name": "Send Expo Push Notifications",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          2200,
          300
        ]
      }
    ],
