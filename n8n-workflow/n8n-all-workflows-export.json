        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://exp.host/--/api/v2/push/send",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
