      "webhookId": "stream-live",
      "credentials": {
        "httpHeaderAuth": {
          "id": "webhook-secret-cred",
          "name": "Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select * from private.n8n_on_stream_live($1::uuid);",
        "queryParams": "={{ $json.body.stream_id }}",
        "options": {}
      },
      "id": "postgres-live-node",
      "name": "Notify Followers in DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [440, 300],
      "credentials": {
        "postgres": {
          "id": "supabase-pooler-cred",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.expo_push_token);\nif (!rows.length) return [];\nconst messages = rows.map(r => ({\n  to: r.expo_push_token,\n  title: r.title,\n  body: r.body,\n  data: r.data,\n  sound: 'default',\n  channelId: 'default'\n}));\nconst chunks = [];\nfor (let i = 0; i < messages.length; i += 100) {\n  chunks.push(messages.slice(i, i + 100));\n}\nreturn chunks.map(c => ({ json: { messages: c } }));"
      },
      "id": "code-batch-push",
      "name": "Build Expo Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://exp.host/--/api/v2/push/send",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.messages) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "http-expo-push",
      "name": "Send Expo Push Notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 300]
    }
  ],
